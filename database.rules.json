{
  "rules": {
    "games": {
      "$gameId": {
        "currentRound": {
          ".read": "auth != null",
          ".write": false
        },
        "participants": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && !data.exists()"
          }
        },
        "submissions": {
          "$roundNumber": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": false,
              ".validate": "newData.hasChildren(['uid', 'championId', 'submittedAt']) && newData.child('uid').val() == auth.uid && (newData.child('championId').val() == 'heracles' || newData.child('championId').val() == 'achilles' || newData.child('championId').val() == 'perseus' || newData.child('championId').val() == 'theseus')"
            }
          }
        },
        "live": {
          "registeredCount": {
            ".read": true,
            ".write": "auth != null && newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "currentRoundVotes": {
            ".read": true,
            ".write": false,
            "$championId": {
              ".write": false,
              ".validate": "newData.isNumber()"
            }
          }
        },
        "scores": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": false
          }
        },
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "roundResults": {
          "$roundNumber": {
            ".read": false,
            ".write": false
          }
        }
      }
    }
  }
}