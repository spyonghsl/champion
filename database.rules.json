{
  "rules": {
    "games": {
      "$gameId": {
        "participants": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && !data.exists()"
          }
        },
        "live": {
          "registeredCount": {
            ".read": true,
            ".write": "auth != null && newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          }
        }
      }
    }
  }
}
