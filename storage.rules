rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /selfies/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 200 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
